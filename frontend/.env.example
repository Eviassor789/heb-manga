# Copy to .env.local for local dev, or set in your Vercel project settings.
#
# Public URL of the FastAPI backend. Used two ways:
#  1. The browser connects to this DIRECTLY for SSE job progress (it cannot
#     be proxied through Next.js without breaking streaming).
#  2. next.config.mjs uses it server-side as the destination for the
#     /api/:path* rewrite fallback (every other API call, e.g. /api/library,
#     /api/weebcentral/*). If this is unset in production, those rewrites fall
#     back to http://localhost:8000 and silently fail on the host.
#
# MUST be a publicly reachable HTTPS URL in production:
#   Local dev:   http://localhost:8000
#   Production:  https://your-backend-host.example.com   (NOT a Vercel URL —
#                the backend runs on a container host, see DEPLOYMENT.md)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
