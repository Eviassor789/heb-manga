# Copy to .env.local for local dev, or set in your Vercel project settings.
#
# Public URL of the FastAPI backend. The browser connects to this DIRECTLY for
# SSE job progress (it cannot be proxied through Next.js without breaking
# streaming), so it MUST be a publicly reachable HTTPS URL in production.
#
#   Local dev:   http://localhost:8000
#   Production:  https://your-backend-host.example.com   (NOT a Vercel URL —
#                the backend runs on a container host, see DEPLOYMENT.md)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
