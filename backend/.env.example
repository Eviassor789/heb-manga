# Copy this file to .env and fill in real values
# .env is gitignored — never commit real keys

# ── Gemini ───────────────────────────────────────────────────────────────────
# In production every job brings its OWN Gemini key (BYOK), so the server key
# below is optional and only used for local dev / manual testing. Leave it
# blank on the public server so the server never pays for translation itself.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pipeline limits
MAX_PAGES_PER_JOB=50

# Model weight paths (relative to backend/) — only used by the local EasyOCR
# fallback. Detection + inpainting always run on the user's Modal GPU (BYOK).
LAMA_MODEL_PATH=./models/lama/big-lama.pth
DETECTOR_MODEL_PATH=./models/comic_text_detector/comictextdetector.pt

# ── Production hardening ──────────────────────────────────────────────────────
# Comma-separated list of EXACT allowed browser origins for CORS. Defaults to
# "*" (fine for local dev). In production set this to your frontend domain(s):
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
ALLOWED_ORIGINS=*

# Max pipelines running heavy stages at once. Extra jobs queue for a slot.
MAX_CONCURRENT_JOBS=2

# Public-endpoint rate limits, per client IP, per minute.
SCRAPE_RATE_PER_MIN=30      # WeebCentral scrape/search endpoints
API_RATE_PER_MIN=120        # library read endpoints

# Background janitor that deletes abandoned/incomplete job folders.
JANITOR_INTERVAL_SECONDS=10800   # run every 3 hours
JANITOR_GRACE_SECONDS=3600        # only delete jobs idle for 60+ minutes

# ── Shared Library — FULL CLOUD mode (Supabase + R2) ─────────────────────────
# Supabase — https://supabase.com → New Project → Settings → API
# Use the service_role key (secret, backend only — never expose to frontend).
# Run the `chapters` table DDL from core/library.py once in the SQL editor.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Cloudflare R2 — https://dash.cloudflare.com → R2 → Manage API Tokens
# Create bucket "manga-chapters", enable Public Access in bucket settings.
R2_ACCOUNT_ID=your_32char_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET=manga-chapters
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Modal GPU ────────────────────────────────────────────────────────────────
# NOTE: This app uses BYOK Modal — each user deploys modal_gpu.py to their OWN
# Modal workspace and supplies their tokens per job. The server does NOT need
# Modal credentials, and there is no USE_MODAL server switch in production.
